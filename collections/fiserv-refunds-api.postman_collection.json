            "name": "Fiserv Refund a captured transaction",
            "description": {
              "content": "Processes a refund against a previously captured and settled transaction. Supports full and partial refunds. The refund amount must not exceed the original captured amount minus any previous refunds.",
              "type": "text/plain"
            },
