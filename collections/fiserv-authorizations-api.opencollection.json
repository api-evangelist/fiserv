{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fiserv BankingHub 3-D Secure Authorizations API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authorizations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fiserv Create an authorization",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://cert.api.fiservapps.com/v1/authorizations",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new authorization for an account or cancels an existing authorization using the card number."
        },
        {
          "info": {
            "name": "Fiserv Cancel an authorization",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://cert.api.fiservapps.com/v1/authorizations/:authorizationId/cancel",
            "params": [
              {
                "name": "authorizationId",
                "value": "",
                "type": "path",
                "description": "The authorization identifier to cancel."
              }
            ]
          },
          "docs": "Cancels a previously created authorization, releasing the hold on the account."
        }
      ]
    }
  ],
  "bundled": true
}