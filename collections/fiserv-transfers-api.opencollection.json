{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fiserv BankingHub 3-D Secure Transfers API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Transfers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fiserv Initiate a fund transfer",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://cert.api.fiservapps.com/banking/transfers",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Initiates a fund transfer between accounts. Supports internal transfers between accounts at the same institution and external transfers via ACH or wire."
        },
        {
          "info": {
            "name": "Fiserv Retrieve transfer details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cert.api.fiservapps.com/banking/transfers/:transferId",
            "params": [
              {
                "name": "transferId",
                "value": "",
                "type": "path",
                "description": "The unique transfer identifier."
              }
            ]
          },
          "docs": "Retrieves the status and details of a previously initiated fund transfer."
        }
      ]
    }
  ],
  "bundled": true
}