{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fiserv BankingHub 3-D Secure Void API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Void",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fiserv Void a transaction",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://cert.api.fiservapps.com/void",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Voids a previously authorized transaction that has not yet been settled. If the transaction has already been settled, use the refund endpoint instead."
        }
      ]
    }
  ],
  "bundled": true
}